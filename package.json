{
  "name": "polanieonline",
  "version": "1.0.0",
  "description": "PolanieOnLine is a fun friendly and free multiplayer online adventure game with an old school feel.",
  "main": "index.js",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
	"test:build-tools": "node --test buildtools/render-contributors.test.cjs",
	"test:translations": "node buildtools/check-language-catalogues.cjs pl en es && node buildtools/check-world-translations.cjs && node buildtools/check-spanish-translations.cjs && node --test src/js/stendhal/util/game-language.test.js src/js/stendhal/util/zone-name-language.test.js src/js/stendhal/event/show-item-list-language.test.js src/js/stendhal/ui/component/item-tooltip-language.test.js src/js/stendhal/entity/generated-message-language.test.js src/js/stendhal/slash-action-language.test.js src/js/stendhal/ui/dialog/travel-log-language.test.js src/js/stendhal/ui/web-display-language.test.js",
	"test:player-mood-icons": "node --test src/js/stendhal/entity/player-mood-icons.test.js",
	"test:arena-observation": "node --test src/js/stendhal/ui/dialog/arena-observation-dialog.test.js",
	"test:viewport-input": "node --test src/js/stendhal/ui/viewport-input.test.js",
	"test:arena-view": "node --test src/js/stendhal/ui/arena-view.test.js",
	"test:entity-actions": "node --test src/js/stendhal/entity/entity-actions.test.js",
	"test:player-stats": "node --test src/js/stendhal/ui/component/player-stats.test.js",
	"test:creature-armor": "node --test src/js/stendhal/ui/render/creature-armor-renderer.test.js",
	"test:quest-markers": "node --test src/js/stendhal/ui/render/quest-marker-renderer.test.js",
	"test:inventory": "node --test src/js/stendhal/ui/component/item-container.test.js src/js/stendhal/ui/component/player-equipment.test.js src/js/stendhal/ui/component/player-stats.test.js src/js/stendhal/data/sprite-store.test.js src/js/stendhal/sprite/item-rarity-effects.test.js",
	"test:admin-diagnostics": "node --test src/js/stendhal/util/admin-diagnostics.test.js src/js/stendhal/util/clipboard.test.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/PolanieOnLine/PolanieOnLine.git"
  },
  "keywords": [
    "game",
    "java",
    "rpg",
    "mmorpg",
    "game-server"
  ],
  "author": "PolanieOnLine",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/PolanieOnLine/PolanieOnLine/issues"
  },
  "homepage": "https://polanieonline.eu",
  "private": true,
  "devDependencies": {
	"esbuild": "0.27.2",
    "markdown-it": "^14.3.1",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.3"
  }
}
